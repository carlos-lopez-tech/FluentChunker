<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Overrides the net8.0;net10.0 from Directory.Build.props: a second TFM doubles run time for no extra signal -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);SKEXP0050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The comparison baseline: the chunker a .NET RAG project reaches for today -->
    <PackageReference Include="Microsoft.SemanticKernel.Core" Version="1.78.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentChunker\FluentChunker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied, because BenchmarkDotNet runs generated child processes whose working directory is not the build output -->
    <!-- Linked from the repository root, which is where the corpus the test sweeps also read lives -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../corpora/*.md" Link="Corpora/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so verification reads the recorded boundaries through the manifest, because a CI build maps source paths to a deterministic root and rewrites the compile-time path that locates this file for recording along with them -->
    <EmbeddedResource Include="Golden/boundaries.txt" />
  </ItemGroup>

</Project>
