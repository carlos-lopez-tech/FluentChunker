<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- BenchmarkDotNet generates its host project under this folder's bin, so it inherits the repository's net8.0;net10.0;net11.0 and restores for net8.0, which cannot reference a net11.0 benchmark assembly.
         Pinning the framework here reaches the generated project too, which a setting in the .csproj alone does not. -->
    <TargetFrameworks>net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
